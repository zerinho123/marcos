# ============================================================================
# CF Finance Backend — variáveis de ambiente
# Copie para .env e preencha os valores reais
# ============================================================================

NODE_ENV=production
HOST=0.0.0.0
PORT=3001

# ── Banco de Dados ──────────────────────────────────────────────────────────
# Mesmo banco do CRM (tabelas Fin* são compartilhadas)
DATABASE_URL=mysql://usuario:senha@localhost:3306/nome_do_banco
# TLS do banco (só se aplica a host remoto / ssl-mode=REQUIRED):
# - Caminho da CA do provedor liga a validação completa do certificado (recomendado):
DB_SSL_CA_PATH=
# - Sem CA, valide assim mesmo forçando rejectUnauthorized=true (precisa cert válido):
DB_SSL_REJECT_UNAUTHORIZED=false

# ── JWT ─────────────────────────────────────────────────────────────────────
# Segredo principal (min 32 chars). Gere com: openssl rand -base64 48
JWT_SECRET_CURRENT=troque-por-um-segredo-de-pelo-menos-32-chars
# Segredo anterior (rotação de chave — deixe vazio se não tiver)
JWT_SECRET_PREVIOUS=
JWT_ISSUER=cfsistema.site
JWT_AUDIENCE=cfsistema-web

# ── Cookies ──────────────────────────────────────────────────────────────────
# Domínio usado apenas para remover cookies legados compartilhados. Cookies
# novos são host-only e não usam Domain.
COOKIE_DOMAIN=.cfsistema.site
# Segredo para assinar cookies (min 32 chars)
COOKIE_SECRET=troque-por-outro-segredo-de-pelo-menos-32-chars
# SameSite: Strict | Lax | None
COOKIE_SAMESITE=Lax

# ── CSRF ─────────────────────────────────────────────────────────────────────
# Segredo HMAC para tokens CSRF (min 32 chars)
CSRF_SECRET=mais-um-segredo-csrf-de-pelo-menos-32-chars

# ── Criptografia em repouso (AES-256-GCM) ────────────────────────────────────
# Cifra campos sensíveis no banco (descrições, credores, devedores, CNPJ etc).
# Gere com: openssl rand -hex 32  (exatamente 64 caracteres hexadecimais)
# Obrigatória em produção. Sem ela, o boot é recusado.
# ⚠️ PERDA DA CHAVE = PERDA IRREVERSÍVEL DOS DADOS CIFRADOS.
#    Guarde uma cópia em cofre/gerenciador de senhas FORA do servidor.
#    Backup do banco só serve acompanhado do backup deste .env.
FINANCE_ENC_KEY_CURRENT=
# Chave anterior (rotação): dado antigo decifra por ela até o re-encrypt em lote.
FINANCE_ENC_KEY_PREVIOUS=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origens permitidas (separadas por vírgula)
CORS_ORIGIN=https://financeiro.cfsistema.site,https://app.cfsistema.site

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Global: 200 req/min por IP
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
# Login: 5 tentativas / 15 min por IP
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# ── Bcrypt ───────────────────────────────────────────────────────────────────
BCRYPT_COST=12

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_REQUESTS=true

# ── Separação Pessoal x Empresarial ──────────────────────────────────────────
# Backfill que MOVE dados escopo='pessoal' para a empresa pessoal de cada dono
# (equivale a database/migrations/005-006). Desligado por padrão: em produção,
# fazer backup do banco ANTES e só então setar =1 (ou rodar as migrations na
# mão). A parte estrutural (FinanceUserEmpresa, Empresa.tipo, empresas pessoais)
# é aditiva e roda sempre, sem flag.
FINANCE_PESSOAL_BACKFILL=0

# ── Webhook CRM → Finance ─────────────────────────────────────────────────────
# Token que o CRM envia no header X-Webhook-Token. O backend valida pelo HASH
# (sha256) guardado em FinanceWebhookToken.token_hash — tokens legados em texto
# puro (coluna `token`) ainda funcionam e são migrados p/ hash na 1ª utilização.
FINANCE_WEBHOOK_SECRET=
